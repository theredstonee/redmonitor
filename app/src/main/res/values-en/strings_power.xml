    <!-- ===== ChargingLimitScreen ===== -->
    <string name="pwr_chg_shizuku_title">Shizuku for charging stop</string>
    <string name="pwr_chg_shizuku_desc">The charge toggle writes directly into the kernel sysfs (/sys/class/power_supply/battery/...). Only the shell-user may do that — Shizuku gives us the access.</string>
    <string name="pwr_chg_title">Smart Charging Limit</string>
    <string name="pwr_chg_battery_now">Battery now</string>
    <string name="pwr_chg_charging_paren">(charging)</string>
    <string name="pwr_chg_not_plugged">(not plugged in)</string>
    <string name="pwr_chg_method">Method</string>
    <string name="pwr_chg_method_sysfs">Hardware stop (sysfs)</string>
    <string name="pwr_chg_method_dumpsys">Soft stop (dumpsys)</string>
    <string name="pwr_chg_path">Path</string>
    <string name="pwr_chg_no_method">Could set up neither sysfs nor the dumpsys fallback. Shizuku shell down?</string>
    <string name="pwr_chg_softstop_note">ℹ On modern MIUI/HyperOS and Samsung Knox the kernel paths are locked — not bypassable even with root without a kernel patch. So we use the OS-level soft stop: `dumpsys battery set ac/usb/wireless 0`. Android stops its charging top-up loop. The status icon shows discharging, the PMIC gets no \'keep charging\' command. Effectiveness varies by vendor — some PMICs still keep going with a minimal trickle charge.</string>
    <string name="pwr_chg_last_action">Last action</string>
    <string name="pwr_chg_auto_stop">Auto-stop at %1$d %%</string>
    <string name="pwr_chg_auto_resume">Auto-resume at %1$d %%</string>
    <string name="pwr_chg_manual_stopped">Stopped manually</string>
    <string name="pwr_chg_manual_resumed">Resumed manually</string>
    <string name="pwr_chg_set_limit">Set limit</string>
    <string name="pwr_chg_limit_value">Limit: %1$d %%</string>
    <string name="pwr_chg_auto_stop_label">Auto-stop when battery reaches the limit</string>
    <string name="pwr_chg_polling_note">Polling every 15 s. Auto-resume when battery drops 5 %% below the limit. This lets the battery float between %1$d–%2$d %%, instead of being pinned at 100 %% 24/7.</string>
    <string name="pwr_chg_manual_actions">Manual actions</string>


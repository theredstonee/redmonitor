    <!-- ===== BatteryDoctorScreen ===== -->
    <string name="pwr_bd_shizuku_title">Shizuku for Battery Doctor</string>
    <string name="pwr_bd_shizuku_desc">Correlates wake-locks (dumpsys power) with dumpsys batterystats — both need the shell privilege.</string>
    <string name="pwr_bd_title">What\'s killing my battery?</string>
    <string name="pwr_bd_explain">Analyzes the last few hours: who holds wake-locks, who wakes up most often, who has the most foreground-service switches. High score = suspicious.</string>

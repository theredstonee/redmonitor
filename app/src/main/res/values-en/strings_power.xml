    <!-- ===== DozeWhitelistScreen ===== -->
    <string name="pwr_doze_shizuku_title">Shizuku for the Doze whitelist</string>
    <string name="pwr_doze_shizuku_desc">Adding/removing apps on the Doze whitelist only works via the shell-user context. Shizuku provides it.</string>

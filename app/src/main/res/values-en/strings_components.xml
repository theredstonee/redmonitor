<resources>
    <!-- OnboardingDialog -->
    <string name="comp_onb_step1_title">Welcome to RedMonitor</string>
    <string name="comp_onb_step1_body">A local, ad-free system-info app. Shows live CPU, RAM, battery, sensors, benchmarks, hardware tests and much more. Everything stays on the device — no cloud, no telemetry.</string>
    <string name="comp_onb_step1_cta">Next</string>
    <string name="comp_onb_step2_title">What you can do</string>
    <string name="comp_onb_step2_body">• Live stats in the \'Live\' tab\n• Benchmark suite: CPU, RAM, storage, GPU, stress test\n• Hardware tests: touch, display, speaker, mic, NFC, IR, compass…\n• Per-app traffic, wake locks, notification log, permission audit\n• Floating HUD over all apps + quick-settings tile</string>
    <string name="comp_onb_step2_cta">Next</string>
    <string name="comp_onb_step3_title">Shizuku = more depth</string>
    <string name="comp_onb_step3_body">Many power features (Logcat, wake locks, shell terminal, force-stop, automatic permission unblocks) need Shizuku — a small app that gives RedMonitor shell privileges without root. Optional, but recommended.</string>
    <string name="comp_onb_step3_cta">Let\'s go</string>
    <string name="comp_onb_back">Back</string>
    <string name="comp_onb_skip">Skip</string>


    <!-- ================= PrivacyDashboardScreen ================= -->
    <string name="sys_pd_shizuku_title">Shizuku for privacy dashboard</string>
    <string name="sys_pd_shizuku_desc">Real permission usage comes from `dumpsys appops`. The Android API for it (AppOpsManager.getPackagesForOps) needs GET_APP_OPS_STATS — only the system has it. Shizuku gives us shell access to it.</string>
    <string name="sys_pd_who_used">Who used WHAT last?</string>
    <string name="sys_pd_desc">Reads the actual access times per app+op from the appops subsystem (camera, mic, location, contacts, SMS, storage, sensors and much more). Sorted by activity score: top = most recent sensitive activity.</string>
    <string name="sys_pd_loading">loading…</string>
    <string name="sys_pd_refresh">Refresh</string>
    <string name="sys_pd_filter">Filter (app, package, op)</string>
    <string name="sys_pd_system">System</string>
    <string name="sys_pd_all_ops">All ops</string>
    <string name="sys_pd_apps_total">%1$d apps · %2$d total</string>
    <string name="sys_pd_cloud_title">My cloud data</string>
    <string name="sys_pd_cloud_desc">Benchmark results only end up on the server if you explicitly contribute them in the benchmark history. Here you can delete everything again.</string>
    <string name="sys_pd_cloud_delete_btn">Delete uploaded benchmark scores</string>
    <string name="sys_pd_cloud_confirm_title">Delete scores?</string>
    <string name="sys_pd_cloud_confirm_body">Permanently deletes all benchmark results uploaded from this device from the server. Your local benchmark history in the app stays untouched.</string>
    <string name="sys_pd_cloud_deleting">Deleting ...</string>
    <string name="sys_pd_cloud_deleted">Deleted.</string>
    <string name="sys_pd_cloud_delete_fail">Deletion failed. Try again later.</string>
    <string name="sys_pd_cloud_delete_confirm">Delete</string>

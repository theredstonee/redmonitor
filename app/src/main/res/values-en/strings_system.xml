    <string name="sys_td_shizuku_title">Shizuku for app actions</string>
    <string name="sys_td_shizuku_desc">Force-stop, soft-kill, clear cache, reset app data, uninstall, deep-freeze, auto-start receivers, standby bucket, background AppOps — everything needs shell access via Shizuku.</string>
    <string name="sys_td_open_appinfo_fallback">For now: open app info in system</string>
    <string name="sys_td_instant_actions">Instant actions</string>
    <string name="sys_td_instant_desc">Force-stop ends all processes. Crash intentionally triggers an ANR/crash (for stability tests). Soft-kill only kills cache/empty processes.</string>
    <string name="sys_td_clear_cache">Clear cache</string>
    <string name="sys_td_clear_cache_btn">Clear cache only (safe)</string>
    <string name="sys_td_clear_cache_desc">Deletes only temporary files — settings, logins and data remain.</string>
    <string name="sys_td_uninstall">Uninstall</string>
    <string name="sys_td_hide_system_app">Hide system app for me</string>
    <string name="sys_td_uninstall_app">Uninstall app</string>
    <string name="sys_td_uninstall_system_desc">System apps can\'t be fully deleted without root. But: \'pm uninstall --user 0\' hides them for you — storage is freed, on a factory reset it comes back.</string>
    <string name="sys_td_uninstall_user_desc">Completely uninstalled. Like removing from the Play Store.</string>
    <string name="sys_td_app_status">App status</string>
    <string name="sys_td_active">Active</string>
    <string name="sys_td_suspended_desc">Suspended — can\'t start, data kept</string>
    <string name="sys_td_running_normal">Running normally</string>
    <string name="sys_td_disable_legacy">Disable (legacy)</string>
    <string name="sys_td_disabled">Disabled</string>
    <string name="sys_td_enabled_samsung">Enabled  ·  often blocked on Samsung</string>
    <string name="sys_td_deepfreeze">Deep-freeze (strongest stop)</string>
    <string name="sys_td_deepfreeze_desc">Force-stop + standby bucket \'never\' + UID idle + suspend in one click. Strongest method without root — the app effectively can\'t run anymore until you wake it.</string>
    <string name="sys_td_freeze_btn">🥶 Freeze</string>
    <string name="sys_td_unfreeze_btn">☀ Unfreeze</string>
    <string name="sys_td_doze">Battery optimization (Doze whitelist)</string>
    <string name="sys_td_on_whitelist">On whitelist</string>
    <string name="sys_td_doze_on_desc">May run in Doze — uses more battery</string>
    <string name="sys_td_doze_off_desc">Throttled in Doze — saves battery</string>
    <string name="sys_td_standby">Standby bucket</string>
    <string name="sys_td_standby_desc">The Android system sorts apps into buckets: active/working_set/frequent/rare/never. The rarer, the less background CPU/network/wakeups the app gets.</string>
    <string name="sys_td_bg">Background behavior (AppOps)</string>
    <string name="sys_td_loading">Loading…</string>
    <string name="sys_td_bg_desc">Both set to \'deny\' = the app gets no more wake locks in the background. Very aggressive — some apps break (push missing, sync stops).</string>
    <string name="sys_td_autostart">Auto-start (boot receiver)</string>
    <string name="sys_td_no_boot_receivers">This app has no BOOT_COMPLETED receivers — so it doesn\'t start automatically after a reboot.</string>
    <string name="sys_td_boot_receivers_count">%1$d receivers listen for boot. Toggle disables them individually.</string>
    <string name="sys_td_misc">Other</string>
    <string name="sys_td_open_in_system">Open in system app info</string>
    <string name="sys_td_danger_zone">⚠ Danger zone</string>
    <string name="sys_td_danger_desc">App reset deletes all settings, logins, cloud tokens, local databases and cache — the app behaves like a fresh install. Cannot be undone.</string>
    <string name="sys_td_reset_btn">Reset app data completely</string>
    <string name="sys_td_confirm">Confirm</string>
    <string name="sys_td_cancel">Cancel</string>
    <string name="sys_td_failed">failed</string>
    <string name="sys_td_cd_title">Delete app data?</string>
    <string name="sys_td_cd_body">%1$s will be reset to factory state. Logins, settings and everything local is gone.</string>
    <string name="sys_td_cd_label">Data deleted</string>
    <string name="sys_td_un_title">Uninstall app?</string>
    <string name="sys_td_un_title_sys">Hide system app?</string>
    <string name="sys_td_un_body">%1$s will be completely removed.</string>
    <string name="sys_td_un_body_sys">%1$s will be hidden for you. It comes back on a factory reset.</string>
    <string name="sys_td_un_label">Uninstalled</string>
    <string name="sys_td_un_label_sys">Hidden</string>

    <!-- ================= TaskManagerScreen ================= -->
    <string name="sys_tm_shizuku_title">Shizuku for task manager</string>
    <string name="sys_tm_shizuku_desc">Since Android 7 an app may only see its own process. With Shizuku (shell-user access) we see all running apps and can force-stop / clear cache / reset app data / deep-freeze.</string>

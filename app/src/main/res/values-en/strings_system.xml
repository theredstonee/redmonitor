    <!-- ================= NotificationLogScreen ================= -->
    <string name="sys_nl_access_needed">Notification access needed</string>
    <string name="sys_nl_access_desc">To log all incoming notifications, RedMonitor needs \'notification access\' (BIND_NOTIFICATION_LISTENER_SERVICE). Android denies this without explicit user granting.</string>
    <string name="sys_nl_open_settings">Open notification settings</string>
    <string name="sys_nl_privacy_desc">Notifications are kept only in RAM (max %1$d). Nothing is saved to disk or sent — gone when the app is closed.</string>
    <string name="sys_nl_clear">Clear log</string>

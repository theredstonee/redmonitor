    <!-- ================= StorageAnalyzerScreen ================= -->
    <string name="sys_sa_shizuku_title">Shizuku for storage analyzer</string>
    <string name="sys_sa_shizuku_desc">Deep directory scan on /sdcard and /data is blocked on Android 11+ without MANAGE_EXTERNAL_STORAGE. Shizuku shell sees everything.</string>
    <string name="sys_sa_scanning">scanning (du -sh)…</string>
    <string name="sys_sa_entries_total">%1$d entries · total %2$s</string>


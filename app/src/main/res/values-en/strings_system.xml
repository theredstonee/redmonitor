    <!-- ================= ApkExtractorScreen ================= -->
    <string name="sys_ax_shizuku_title">Shizuku for APK extract</string>
    <string name="sys_ax_shizuku_desc">`pm path &lt;pkg&gt;` lists the APK files (incl. split APKs). Copying from /data/app/.../ needs shell rights — Shizuku provides them.</string>
    <string name="sys_ax_title">APK Extractor</string>
    <string name="sys_ax_desc">Extracts the installed APK (base + all splits) to /sdcard/Download/redmonitor-apks/&lt;pkg&gt;/. From there you can share it, e.g. with a file manager.</string>
    <string name="sys_ax_extracted">✓ Extracted</string>
    <string name="sys_ax_error">✗ Error</string>

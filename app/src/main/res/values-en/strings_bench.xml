    <!-- ===== CpuBenchmarkScreen ===== -->
    <string name="bench_cpu_desc">4 sub-tests Geekbench-style: integer math, floating-point, SHA-256 crypto, quicksort. Single + multi-core. Runs in a foreground service — the activity may go to the background.</string>
    <string name="bench_cpu_phase_duration">Duration per phase (× 4 tests × 2 modes)</string>
    <string name="bench_cpu_total">Total: ~%1$d min %2$d s</string>
    <string name="bench_cpu_start">Start benchmark</string>
    <string name="bench_cpu_notes">Notes</string>
    <string name="bench_cpu_notes_body">· Close games/streaming apps beforehand for more stable scores\n· The bench service runs as a foreground notification — you can leave the app in the background\n· The result lands in history automatically</string>

    <!-- ===== GpuBenchmarkScreen ===== -->
    <string name="bench_gpu_starting">Starting…</string>
    <string name="bench_gpu_title">GPU benchmark (real GLES2 shaders)</string>
    <string name="bench_gpu_desc">3 sub-tests of 15 s each with real OpenGL ES 2 shaders (vertex and fragment shaders, VBOs). Unlike the old scissor trick, this actually renders.</string>
    <string name="bench_gpu_detail">VERTEX: 50,000 rotating triangles per frame · FILL-RATE: 30× fullscreen quad with alpha blending (overdraw) · SHADER: 32-iter fractal fragment shader.</string>
    <string name="bench_gpu_start">Start fullscreen test</string>
    <string name="bench_gpu_total_score">Total score</string>
    <string name="bench_gpu_avg_of_3">Average of 3 sub-tests</string>

    <!-- ===== RamBenchmarkScreen ===== -->
    <string name="bench_ram_title">RAM bandwidth (tier-aware)</string>
    <string name="bench_ram_desc">Measures read/write/copy across 4 buffer sizes: 32 KB (L1), 1 MB (L2), 16 MB (L3/SLC) and 256 MB (DRAM). Runs in a foreground service.</string>
    <string name="bench_ram_duration_per_op">Duration per operation × tier</string>
    <string name="bench_ram_total">Total: 4 tiers × 3 ops × %1$ds = %2$ds</string>

    <!-- ===== StorageBenchmarkScreen ===== -->
    <string name="bench_storage_title">Storage sequential — sustained</string>
    <string name="bench_storage_desc">Writes and reads continuously. Sustained = real flash throughput (fsync every 32 MB). Peak = SLC cache burst.</string>
    <string name="bench_storage_duration_per_phase">Duration per phase (write + read)</string>
    <string name="bench_storage_total">Total: %1$d s · 512 MB file cap</string>


    <!-- RouletteScreen -->
    <string name="scr2_roul_outcome_safe">Got lucky</string>
    <string name="scr2_roul_outcome_app">Random app killed</string>
    <string name="scr2_roul_outcome_sysui">⚠ SystemUI crashed</string>
    <string name="scr2_roul_outcome_fork">☣ FORK BOMB triggered</string>
    <string name="scr2_roul_outcome_shutdown">☠ SHUTDOWN</string>
    <string name="scr2_roul_intro" formatted="false">59 % nothing. 30 % random app crashed. 8 % SystemUI down (comes back after 2 s). 1 % fork bomb (forces reboot). 2 % the phone powers OFF.</string>
    <string name="scr2_roul_shizuku_title">Shizuku required</string>
    <string name="scr2_roul_shizuku_desc">Roulette needs shell access via Shizuku — otherwise the system cannot kill apps or shut down.</string>
    <string name="scr2_roul_rolling">Rolling...</string>
    <string name="scr2_roul_fire">PULL THE TRIGGER</string>
    <string name="scr2_roul_dist_title">Distribution</string>
    <string name="scr2_roul_dist_nothing">Nothing happens</string>
    <string name="scr2_roul_dist_app">Random user app crashed</string>
    <string name="scr2_roul_dist_sysui">SystemUI crashed (comes back)</string>
    <string name="scr2_roul_dist_fork">☣ Fork bomb × 24 (until reboot)</string>
    <string name="scr2_roul_dist_shutdown">☠ Phone powers OFF</string>
    <string name="scr2_roul_warn_title">⚠ Russian Roulette — Warning</string>
    <string name="scr2_roul_warn_intro">This feature performs real destructive actions:</string>
    <string name="scr2_roul_warn_b1" formatted="false">• At 30 % a random installed app is force-killed — unsaved progress is lost</string>
    <string name="scr2_roul_warn_b2" formatted="false">• At 8 % the SystemUI is killed — briefly no status bar/navigation</string>
    <string name="scr2_roul_warn_b3" formatted="false">• At 1 % 24 parallel fork bombs are launched — they survive sessions and respawn. The phone stays sluggish until you HARD-reboot it (hold the power button)</string>
    <string name="scr2_roul_warn_b4" formatted="false">• At 2 % the phone is shut down IMMEDIATELY after a 3-second countdown — active writes may get corrupted</string>
    <string name="scr2_roul_warn_risk">At your own risk only. Save everything first. This feature is meant as a gimmick.</string>
    <string name="scr2_roul_warn_check">Understood — I use this at my own risk</string>
    <string name="scr2_roul_warn_ok">OK, unlock</string>
    <string name="scr2_roul_cancel">Cancel</string>
    <string name="scr2_roul_detail_shelllocked">shell-locked, no cancel</string>
    <string name="scr2_roul_detail_shutdown">Shutdown in 3s (detached, no cancel)</string>
    <string name="scr2_roul_detail_no_candidate">no running candidate found</string>


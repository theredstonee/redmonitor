    <string name="sys_td_shizuku_title">Shizuku für App-Aktionen</string>
    <string name="sys_td_shizuku_desc">Force-Stop, Soft-Kill, Cache leeren, App-Daten zurücksetzen, Deinstallieren, Deep-Freeze, Auto-Start-Receiver, Standby-Bucket, Background-AppOps — alles braucht shell-Zugriff via Shizuku.</string>
    <string name="sys_td_open_appinfo_fallback">Bis dahin: App-Info im System öffnen</string>
    <string name="sys_td_instant_actions">Sofort-Aktionen</string>
    <string name="sys_td_instant_desc">Force-Stop beendet alle Prozesse. Crash löst absichtlich einen ANR/Crash aus (für Stabilitäts-Tests). Soft-Kill killt nur Cache/leere Prozesse.</string>
    <string name="sys_td_clear_cache">Cache leeren</string>
    <string name="sys_td_clear_cache_btn">Nur Cache leeren (safe)</string>
    <string name="sys_td_clear_cache_desc">Löscht nur temporäre Dateien — Einstellungen, Logins und Daten bleiben.</string>
    <string name="sys_td_uninstall">Deinstallieren</string>
    <string name="sys_td_hide_system_app">System-App für mich verstecken</string>
    <string name="sys_td_uninstall_app">App deinstallieren</string>
    <string name="sys_td_uninstall_system_desc">System-Apps können nicht komplett gelöscht werden ohne Root. Aber: \'pm uninstall --user 0\' versteckt sie für dich — Speicher wird frei, beim Werksreset kommt sie wieder.</string>
    <string name="sys_td_uninstall_user_desc">Vollständig deinstalliert. Wie aus dem Play Store entfernen.</string>
    <string name="sys_td_app_status">App-Status</string>
    <string name="sys_td_active">Aktiv</string>
    <string name="sys_td_suspended_desc">Suspendiert — kann nicht starten, Daten erhalten</string>
    <string name="sys_td_running_normal">Läuft normal</string>
    <string name="sys_td_disable_legacy">Disable (alt)</string>
    <string name="sys_td_disabled">Disabled</string>
    <string name="sys_td_enabled_samsung">Enabled  ·  oft gesperrt auf Samsung</string>
    <string name="sys_td_deepfreeze">Deep-Freeze (stärkster Stop)</string>
    <string name="sys_td_deepfreeze_desc">Force-Stop + Standby-Bucket \'never\' + UID-Idle + Suspend in einem Klick. Stärkste Methode ohne Root — App kann faktisch nicht mehr laufen, bis du sie aufweckst.</string>
    <string name="sys_td_freeze_btn">🥶 Einfrieren</string>
    <string name="sys_td_unfreeze_btn">☀ Auftauen</string>
    <string name="sys_td_doze">Akku-Optimierung (Doze-Whitelist)</string>
    <string name="sys_td_on_whitelist">Auf Whitelist</string>
    <string name="sys_td_doze_on_desc">Darf in Doze laufen — frisst mehr Akku</string>
    <string name="sys_td_doze_off_desc">Wird in Doze gedrosselt — spart Akku</string>
    <string name="sys_td_standby">Standby-Bucket</string>
    <string name="sys_td_standby_desc">Android-System teilt Apps in Buckets ein: active/working_set/frequent/rare/never. Je seltener, desto weniger Background-CPU/Netz/Wakeups bekommt die App.</string>
    <string name="sys_td_bg">Hintergrund-Verhalten (AppOps)</string>
    <string name="sys_td_loading">Lade…</string>
    <string name="sys_td_bg_desc">Beide auf \'deny\' = App bekommt keine Wake-Locks mehr im Hintergrund. Sehr aggressiv — manche Apps brechen dabei (Push fehlt, Sync stoppt).</string>
    <string name="sys_td_autostart">Auto-Start (Boot-Receiver)</string>
    <string name="sys_td_no_boot_receivers">Diese App hat keine BOOT_COMPLETED-Receiver — startet also nicht automatisch nach Neustart.</string>
    <string name="sys_td_boot_receivers_count">%1$d Receiver hören auf Boot. Toggle deaktiviert sie individuell.</string>
    <string name="sys_td_misc">Sonstiges</string>
    <string name="sys_td_open_in_system">Im System-App-Info öffnen</string>
    <string name="sys_td_danger_zone">⚠ Gefährliche Zone</string>
    <string name="sys_td_danger_desc">App-Reset löscht alle Einstellungen, Logins, Cloud-Tokens, lokale Datenbanken und Cache — die App wirkt wie frisch installiert. Nicht rückgängig zu machen.</string>
    <string name="sys_td_reset_btn">App-Daten komplett zurücksetzen</string>
    <string name="sys_td_confirm">Bestätigen</string>
    <string name="sys_td_cancel">Abbrechen</string>
    <string name="sys_td_failed">fehlgeschlagen</string>
    <string name="sys_td_cd_title">App-Daten löschen?</string>
    <string name="sys_td_cd_body">%1$s wird auf Werkszustand zurückgesetzt. Logins, Einstellungen und alles Lokale ist weg.</string>
    <string name="sys_td_cd_label">Daten gelöscht</string>
    <string name="sys_td_un_title">App deinstallieren?</string>
    <string name="sys_td_un_title_sys">System-App verstecken?</string>
    <string name="sys_td_un_body">%1$s wird komplett entfernt.</string>
    <string name="sys_td_un_body_sys">%1$s wird für dich versteckt. Beim Werksreset kommt sie wieder.</string>
    <string name="sys_td_un_label">Deinstalliert</string>
    <string name="sys_td_un_label_sys">Versteckt</string>


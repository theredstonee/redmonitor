    <!-- ===== ChargingLimitScreen ===== -->
    <string name="pwr_chg_shizuku_title">Shizuku für Charging-Stop</string>
    <string name="pwr_chg_shizuku_desc">Charge-Toggle schreibt direkt in den Kernel-Sysfs (/sys/class/power_supply/battery/...). Das erlaubt nur der shell-User — Shizuku gibt uns den Zugriff.</string>
    <string name="pwr_chg_title">Smart Charging Limit</string>
    <string name="pwr_chg_battery_now">Akku jetzt</string>
    <string name="pwr_chg_charging_paren">(lädt)</string>
    <string name="pwr_chg_not_plugged">(nicht am Strom)</string>
    <string name="pwr_chg_method">Methode</string>
    <string name="pwr_chg_method_sysfs">Hardware-Stop (Sysfs)</string>
    <string name="pwr_chg_method_dumpsys">Soft-Stop (dumpsys)</string>
    <string name="pwr_chg_path">Pfad</string>
    <string name="pwr_chg_no_method">Konnte weder Sysfs noch dumpsys-Fallback einrichten. Shizuku-shell down?</string>
    <string name="pwr_chg_softstop_note">ℹ Auf modernem MIUI/HyperOS und Samsung Knox sind die Kernel-Pfade gelocked — selbst mit root nicht aushebelbar ohne Kernel-Patch. Wir nehmen daher den OS-Level-Soft-Stop: `dumpsys battery set ac/usb/wireless 0`. Android stoppt seine Charging-Top-Up-Loop. Status-Icon zeigt entladen, der PMIC bekommt kein \'weiter laden\'-Kommando. Wirksamkeit variiert je nach Vendor — manche PMICs fahren trotzdem mit minimaler Erhaltungsladung weiter.</string>
    <string name="pwr_chg_last_action">Letzte Aktion</string>
    <string name="pwr_chg_auto_stop">Auto-Stop bei %1$d %%</string>
    <string name="pwr_chg_auto_resume">Auto-Resume bei %1$d %%</string>
    <string name="pwr_chg_manual_stopped">Manuell gestoppt</string>
    <string name="pwr_chg_manual_resumed">Manuell fortgesetzt</string>
    <string name="pwr_chg_set_limit">Limit einstellen</string>
    <string name="pwr_chg_limit_value">Limit: %1$d %%</string>
    <string name="pwr_chg_auto_stop_label">Auto-Stop wenn Akku Limit erreicht</string>
    <string name="pwr_chg_polling_note">Polling alle 15 s. Resume automatisch wenn Akku 5 %% unter Limit fällt. Damit kann der Akku zwischen %1$d–%2$d %% schweben, statt 24/7 auf 100 %% gequetscht zu werden.</string>
